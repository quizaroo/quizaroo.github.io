# Open Flashcards server settings. install.sh copies this to /etc/open-flashcards/open-flashcards.env.
# Change a value, then: systemctl restart open-flashcards-server

# first  = the first account can be created, then registration closes (default)
# open   = anyone who can reach the server can create an account
# closed = nobody can create accounts
REGISTRATION=first

# Web addresses the app is served from (comma separated, no spaces).
ALLOWED_ORIGINS=https://hazymat.github.io,http://localhost:5173

# Storage limit per account, in MB.
QUOTA_MB=1024

# Port the server listens on (127.0.0.1 only). Change it if something else on the machine uses it.
PORT=8797
