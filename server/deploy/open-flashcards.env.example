# Quizaroo server settings. install.sh copies this to /etc/open-flashcards/open-flashcards.env.
# Change a value, then: systemctl restart open-flashcards-server

# first  = the first account can be created, then registration closes (default)
# open   = anyone who can reach the server can create an account
# closed = nobody can create accounts
REGISTRATION=first

# Web addresses the app is served from (comma separated, no spaces).
ALLOWED_ORIGINS=https://quizaroo.github.io,https://hazymat.github.io,http://localhost:5173

# Storage limit per account, in MB. Accounts in ADMIN_EMAILS have no limit but the disk.
QUOTA_MB=1024

# New accounts allowed per day (UTC). 0 = no limit.
MAX_SIGNUPS_PER_DAY=0

# Accounts that can use /admin (comma separated). Create the account before opening sign-ups, so nobody else can take the address.
ADMIN_EMAILS=

# Port the server listens on (127.0.0.1 only). Change it if something else on the machine uses it.
PORT=8797

# Ask new accounts to confirm their address with a code sent by email. Needs a mail server this machine can use without signing in (SMTP_HOST, default 127.0.0.1; SMTP_PORT, default 25).
EMAIL_CODES=off
MAIL_FROM=
